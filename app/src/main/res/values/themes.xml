<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tema.Plantao" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fundo_janela</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Tema.Plantao.Alarme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fundo_alarme</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Tema.Plantao.Invisivel" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
    </style>
</resources>
