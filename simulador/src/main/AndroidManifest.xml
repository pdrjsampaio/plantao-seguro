<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_action_chat"
        android:label="Simulador de mensagens">

        <activity
            android:name=".Conversa"
            android:exported="true"
            android:label="Conversa">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Recebe ordens do teste (adb/UiAutomator). DUMP: só o shell e o sistema podem mandar. -->
        <receiver
            android:name=".Comando"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
